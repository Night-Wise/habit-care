{
  "expo": {
    "name": "HabitCare",
    "slug": "habitcare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "habitapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.rahulkumar.habitcare"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0C0A1D",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rahulkumar.habitcare"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0A1D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 100
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/ringtones/funny.mp3",
            "./assets/ringtones/dino.mp3",
            "./assets/ringtones/clock.mp3",
            "./assets/ringtones/eas.mp3",
            "./assets/ringtones/stardust.mp3",
            "./assets/ringtones/digital.mp3"
          ]
        }
      ],
      "expo-image",
      "expo-web-browser",
      "./plugins/withAndroidReleaseSigning.js",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
